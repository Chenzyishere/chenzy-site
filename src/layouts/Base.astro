---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Menu from '../components/Menu';
import Cursor from '../components/Cursor.astro';
import Transition from '../components/Transition.astro';
import { site } from '../data/site';

type Props = {
  title?: string;
  description?: string;
  theme?: 'blue' | 'paper';
};

const {
  title,
  description = site.description,
  theme = 'paper',
} = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.manifesto}`;
---

<!doctype html>
<html lang="zh-CN" data-theme={theme}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).toString()} />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Alumni+Sans:wght@700;800&family=Anton&family=Noto+Sans+SC:wght@400;500;700;900&family=Noto+Serif+SC:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Header />
    <slot />
    <Footer />
    <Menu client:load />
    <Cursor />
    <Transition />
  </body>
</html>
